# ===========================
# Bank Server Build System
# ===========================
#
# Targets:
#   make            - build the server (default)
#   make all        - server + init_sessions + client
#   make server     - just the server
#   make client     - the CLI client (../client)
#   make sessions_tool - the standalone session-file initialiser
#   make debug      - server with -O0 -g and ASan/UBSan
#   make clean      - remove all build outputs
#
# Compiler flags are intentionally strict: warnings are errors, FORTIFY_SOURCE
# is on, stack canaries and PIE are enabled. Loosen them locally if you must,
# but do not commit a weaker default.

CC      ?= cc
INCLUDE  = -Iinclude

WARN_FLAGS = -Wall -Wextra -Wstrict-prototypes -Wwrite-strings \
             -Wshadow -Wpointer-arith -Wcast-align -Wno-unused-parameter

HARDEN_FLAGS = -fstack-protector-strong -D_FORTIFY_SOURCE=2 -fPIE

# macOS clang complains about -pie at link time (PIE is default on darwin),
# while Linux gcc/ld require it explicitly. Branch on uname.
UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Linux)
LDHARDEN = -pie -Wl,-z,relro,-z,now
else
LDHARDEN =
endif

CFLAGS  ?= -O2 -g $(WARN_FLAGS) $(HARDEN_FLAGS) -MMD -MP
LDFLAGS ?= $(LDHARDEN)

# Source layout ---------------------------------------------------------------

SRV_SRC = src/server.c \
          src/handler.c \
          src/common.c \
          src/admin.c \
          src/admin_utils.c \
          src/manager.c \
          src/manager_utils.c \
          src/employee.c \
          src/employee_utils.c \
          src/customer.c \
          src/customer_utils.c

SRV_OBJ = $(SRV_SRC:.c=.o)
SRV_DEP = $(SRV_SRC:.c=.d)

SRV_OUT          = server
INIT_SESSIONS    = init_sessions
CLIENT_OUT       = ../client

# Top-level targets -----------------------------------------------------------

.PHONY: all server client sessions_tool debug clean

all: $(SRV_OUT) $(INIT_SESSIONS) client

server: $(SRV_OUT)

$(SRV_OUT): $(SRV_OBJ)
	$(CC) $(CFLAGS) $(INCLUDE) $^ -o $@ $(LDFLAGS)

sessions_tool: $(INIT_SESSIONS)

$(INIT_SESSIONS): src/init_sessions.c
	$(CC) $(CFLAGS) $(INCLUDE) $< -o $@ $(LDFLAGS)

client: $(CLIENT_OUT)

$(CLIENT_OUT): ../client.c
	$(CC) $(CFLAGS) $< -o $@ $(LDFLAGS)

# Debug build: drop optimisation, add sanitizers. Cannot be combined with
# -fPIE on every platform, so this overrides the hardening LDFLAGS.
debug: CFLAGS  = -O0 -g3 $(WARN_FLAGS) -fsanitize=address,undefined -MMD -MP
debug: LDFLAGS = -fsanitize=address,undefined
debug: clean $(SRV_OUT)

clean:
	rm -f $(SRV_OUT) $(INIT_SESSIONS) $(CLIENT_OUT) \
	      $(SRV_OBJ) $(SRV_DEP) src/*.d src/*.o

# Pattern rule ----------------------------------------------------------------

%.o: %.c
	$(CC) $(CFLAGS) $(INCLUDE) -c $< -o $@

# Header-dependency tracking (auto-generated by -MMD -MP).
-include $(SRV_DEP)
